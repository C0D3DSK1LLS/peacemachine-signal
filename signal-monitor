    def io_panel(self, y, x, width):
        m = self.monitor
        self.box(y, x, 6, width, "I/O", self.BLUE, "~~~~")
        for index, (label, key) in enumerate((("NET ↓", "rx"), ("NET ↑", "tx"), ("READ ", "read"), ("WRITE", "write"))):
            message = rate(m.graphs[key][-1]) if m.graphs[key] else "—"
            if key in ("rx", "tx") and not m.links:
                message = "—"
            if key in ("read", "write") and not m.drives:
                message = "—"
            self.put(y + 1 + index, x + 2, f"{label}....{message}", self.BLUE if index < 2 else 5, width - 4)

    def process_rows(self):
        query = self.filter.casefold()
        rows = [p for p in self.monitor.procs if query in p.name.casefold() or query in str(p.pid)]
        field = self.SORT_FIELDS[self.sort]
        rows.sort(key=lambda p: (p[field].casefold() if field == 1 else p[field], p.pid), reverse=self.reverse)
        if not self.tree or query:
            return [(proc, "") for proc in rows]
        children = defaultdict(list)
        pids = {proc.pid for proc in rows}
        for proc in rows:
            children[proc.parent if proc.parent in pids and proc.parent != proc.pid else 0].append(proc)
        tree = []
        stack = [(root, "", "", "") for root in reversed(children[0])]
        while stack:
            proc, prefix, branch, continuation = stack.pop()
            tree.append((proc, prefix + branch))
            kids = children[proc.pid]
            for index in range(len(kids) - 1, -1, -1):
                last = index == len(kids) - 1
                stack.append((kids[index], prefix + continuation, "└─" if last else "├─", "  " if last else "│ "))
        return tree

    def process_panel(self, y, width, height):
        rows = self.process_rows()
        mode = "TREE" if self.tree and not self.filter else "LIST"
        arrow = "↓" if self.reverse else "↑"
        title = f"PROCESSES // {mode} // {self.SORT_LABELS[self.sort]} {arrow}"
        self.box(y, 0, height, width, title, self.RED, "----....", rail_color=self.DARK_RED)
        has_map = height >= 14
        if has_map:
            self.process_heatmap(y + 1, width, rows)
        header = y + 1 + has_map
        expanded = width >= 81
        trace_width = min(14, 9 + max(0, width - 65) // 8)
        fields = [("PID", 7, True), ("COMMAND", 0, False), ("CPU TRACE", trace_width, False),
                  ("CPU %", 7, True), ("RAM", 9, True), ("S", 1, False)]
        if expanded:
            fields[2:2] = [("THR", 4, True), ("USER", 8, False)]
        command_width = width - 4 - (len(fields) - 1) - sum(field[1] for field in fields)
        fields[1] = ("COMMAND", command_width, False)
        column_colors = {
            "PID": self.RED, "THR": self.ORANGE, "USER": self.ORANGE,
            "CPU TRACE": self.RED, "CPU %": self.NEON_GREEN, "RAM": 1, "S": 1,
        }
        haloes = {"PID": self.DARK_RED, "USER": self.AMBER_HALO, "CPU %": 9, "RAM": self.AQUA_HALO}
        x = 2
        positions = {}
        glow_columns = []
        for label, cells, align_right in fields:
            positions[label] = x
            align = ">" if align_right else "<"
            self.put(header, x, f"{label:{align}{cells}.{cells}}",
                     column_colors.get(label, self.PROCESS_GREY), cells)
            if label in haloes:
                glow_columns.append((x + cells, haloes[label]))
                self.put(header, x + cells, "▏", haloes[label])
            x += cells + 1
        has_footer = height >= 9
        self.visible_processes = max(1, height - 3 - has_footer - has_map)
        self.scroll_limit = max(0, len(rows) - self.visible_processes)
        self.offset = min(self.offset, self.scroll_limit)
        for line, (proc, branch) in enumerate(rows[self.offset:self.offset + self.visible_processes]):
            row = header + line + 1
            branch = branch[-max(2, command_width // 2):]
            command_x = positions["COMMAND"]
            hot = proc.cpu >= 80
            if hot or proc.state == "running":
                self.put(row, 1, "▐" if hot else "▎", self.RED if hot else self.PROCESS_GREY)
            for col, shadow in glow_columns:
                self.put(row, col, "┊", shadow)
            self.put(row, positions["PID"], f"{proc.pid:>7}", self.RED, 7)
            self.put(row, command_x + len(branch), proc.name,
                     self.RED if hot else self.PROCESS_GREY, command_width - len(branch))
            if branch:
                self.put(row, command_x, branch, self.PROCESS_DIM, len(branch))
            if expanded:
                self.put(row, positions["THR"], f"{proc.threads or '—':>4}", self.ORANGE, 4)
                self.put(row, positions["USER"], proc.user, self.ORANGE, 8)
            self.process_trace(row, positions["CPU TRACE"], trace_width, self.monitor.proc_traces[proc.pid])
            self.put(row, positions["CPU %"], f"{proc.cpu:>7.1f}", self.NEON_GREEN, 7)
            self.put(row, positions["RAM"], f"{size(proc.rss):>9}", 1, 9)
            self.put(row, positions["S"], proc.state[:1].upper(), 1, 1)
        if not rows:
            self.put(header + 1, 2, "No matching processes", self.PROCESS_GREY, width - 4)
        if self.scroll_limit and self.visible_processes >= 5:
            track = self.visible_processes
            thumb = max(1, round(track * self.visible_processes / len(rows)))
            start = round((track - thumb) * self.offset / self.scroll_limit)
            for pos in range(track):
                active = start <= pos < start + thumb
                self.put(header + 1 + pos, width - 1, "▌" if active else "┆",
                         self.PROCESS_GREY if active else self.DARK_RED)
        if has_footer:
            rail = y + height - 2
            self.put(rail, 2, ("----...." * width)[:width - 4], self.DARK_RED)
            first = self.offset + 1 if rows else 0
            last = min(len(rows), self.offset + self.visible_processes)
            self.put(rail, 4, f" {first}–{last} / {len(rows)} ", self.PROCESS_GREY)
            hot_count = sum(proc.cpu >= 80 for proc, _ in rows)
            activity = f" {hot_count} ≥80% CPU "
            self.put(rail, width - len(activity) - 4, activity, self.RED if hot_count else self.PROCESS_DIM)

    def process_heatmap(self, row, width, rows):
        left = " ◈ LOAD MAP "
        active = sum(proc.cpu > 0 for proc, _ in rows)
        right = f" {active} ACTIVE "
        space = width - 4 - len(left) - len(right) - 2
        count = min(16, space // 2)
        busiest = nlargest(count, (proc for proc, _ in rows), key=lambda proc: proc.cpu)
        self.put(row, 2, left, self.RED)
        x = 2 + len(left)
        self.put(row, x, "║", self.DARK_RED)
        fills = "·░▒▓█"
        for index in range(count):
            load = busiest[index].cpu if index < len(busiest) else 0
            level = min(4, math.ceil(load / 25))
            color = self.RED if load >= 80 else self.DARK_RED if load >= 40 else self.PROCESS_DIM
            self.put(row, x + 1 + index * 2, fills[level] * 2, color)
        gap = space - count * 2
        self.put(row, x + 1 + count * 2, "." * gap, self.DARK_RED)
        self.put(row, width - 3 - len(right), "║", self.DARK_RED)
        self.put(row, width - 2 - len(right), right, self.PROCESS_GREY)

    def process_trace(self, row, x, width, history):
        values = list(history)[-2 * width:]
        values = [0.0] * (2 * width - len(values)) + values
        for col, (left, right) in enumerate(zip(values[::2], values[1::2])):
            first = self.DOTS[0][min(4, math.ceil(left / 25))]
            second = self.DOTS[1][min(4, math.ceil(right / 25))]
            peak = max(left, right)
            color = 1 if peak else self.DARK_RED
            self.put(row, x + col, chr(0x2800 + (first | second)) if peak else ".", color)

    def detail(self, height, width):
        m = self.monitor
        if self.page == 1:
            self.put(3, 2, m.model, 1)
            self.put(4, 2, f"{m.physical or '?'} physical cores  /  {len(m.cores)} logical CPUs  /  {m.allowed} available to Signal")
            if m.core_temps:
                self.put(5, 2, "Temperature is shared by threads on the same physical core.", 2)
            self.cpu_panel(6, width, height - 7)
            return
        if self.page == 5:
            self.process_panel(3, width, height - 4)
            return
        lines = []
        if self.page == 2:
            title, color = "NVIDIA GPU", 4
            for name, load, temp, used, total, power, fan in m.gpus:
                lines.extend([name, f"Load {metric(load, '%')}    Temp {metric(temp, '°C')}    "
                              f"Power {metric(power, ' W')}    Fan {metric(fan, '%')}",
                              f"VRAM {used} / {total} MiB", ""])
            if not lines:
                lines.append(m.gpu_message)
            graph_keys = (("gpu", "GPU load"),) if m.gpus else ()
        elif self.page == 3:
            title, color = "STORAGE", 5
            lines.extend(f"{usage.percent:5.1f}%  {size(usage.used):>10} / {size(usage.total):<10}  {path}"
                         for path, usage in m.mounts)
            if not lines:
                lines.append("No filesystem statistics")
            lines.append("")
            lines.extend(f"{name:<16} read {rate(read):>13}   write {rate(write):>13}"
                         for name, read, write in m.drives)
            graph_keys = (("read", "Read"), ("write", "Write")) if m.drives else ()
        else:
            title, color = "NETWORK", 1
            lines = [f"{name:<16} down {rate(rx):>13}     up {rate(tx):>13}" for name, rx, tx in m.links]
            if not lines:
                lines.append("No non-loopback interfaces visible")
            graph_keys = (("rx", "Receive"), ("tx", "Transmit")) if m.links else ()
        trim = "~~~~" if self.page == 4 else "----...."
        self.box(3, 0, height - 4, width, title, self.BLUE if self.page == 4 else color, trim)
        graph_space = 5 * len(graph_keys) if height >= 22 else 0
        line_count = height - 6 - graph_space
        self.visible_processes = line_count
        self.scroll_limit = max(0, len(lines) - line_count)
        self.detail_scroll = min(self.detail_scroll, self.scroll_limit)
        for index, line in enumerate(lines[self.detail_scroll:self.detail_scroll + line_count]):
            self.put(4 + index, 2, line, 3, width - 4)
        if graph_space:
            for index, (key, label) in enumerate(graph_keys):
                y = height - 2 - graph_space + index * 5
                history = m.graphs[key]
                upper = 100 if key == "gpu" else max(1, max(history, default=0))
                peak = "100%" if key == "gpu" else rate(upper)
                self.put(y, 2, f"{label}  /  scale {peak}", color)
                self.graph(y + 1, 2, 3, width - 4, key, upper, color)

    def draw(self):
        self.win.erase()
        self.binary_regions.clear()
        self.glyph_region = None
        height, actual_width = self.win.getmaxyx()
        width = actual_width - 1
        if height < 20 or width < 61:
            self.put(0, 0, "SIGNAL  /  resize to at least 62 columns × 20 rows")
            self.win.refresh()
            return
        m = self.monitor
        self.put(0, 0, "░▒▓", 6)
        self.put(0, 3, "█  S I G N A L  █", 0)
        self.put(0, 20, "▓▒░", 6)
        host = f"{m.host}  /  UP {age(time.time() - m.boot)}  /  {time.strftime('%H:%M:%S')}"
        host_x = max(24, width - len(host) - 1)
        glyph_start = 25
        if host_x >= 49:
            self.put(0, 25, "⟪ OPERATIONS CONSOLE ⟫", 1)
            glyph_start = 49
        self.put(0, host_x, host, 2)
        glyph_space = host_x - glyph_start
        count = (glyph_space - 3) // 2
        if count >= 2:
            self.glyph_region = (glyph_start + 1, count)
        x = 1
        for index, name in enumerate(self.KEYS):
            label = f"{index + 1} {name}"
            self.put(1, x, label, 0 if index == self.page else 2)
            x += len(label) + (2 if width >= 76 else 1)
        if width - x >= 6:
            self.binary_regions.append((1, x, 1, width - x - 1))
        self.put(2, 0, ("-----....." * width)[:width], 2)
        label = " LOCAL TELEMETRY "
        self.put(2, 2, label, 6)
        tick = int(time.monotonic() / m.interval)
        sweep_start = 3 + len(label)
        sweep_width = width - 15 - sweep_start
        sweep = sweep_start + tick % sweep_width
        for col, glyph, color in ((sweep - 2, "░", self.DARK_BLUE), (sweep - 1, "▒", self.BLUE), (sweep, "▌", 1)):
            if col >= sweep_start:
                self.put(2, col, glyph, color)
        pulse = ("·..", ".·.", "..·")[tick % 3]
        self.put(2, width - 12, f" {pulse} LIVE ", 0)
        if self.help:
            self.box(3, 0, height - 4, width, "KEYS", 1)
            entries = ("1–6  Switch views         Tab  Next view",
                       "↑/↓  Scroll               PgUp/PgDn  Scroll by page",
                       "s    Sort processes      r    Reverse sort",
                       "t    Tree/list view",
                       "b    Toggle animated binary",
                       "/    Filter by PID/name  Esc  Clear filter",
                       "?    Toggle this help    q    Quit",
                       "Process CPU: 100% equals one logical CPU.",
                       "Red CPU meters indicate 80% or higher.")
            for index, entry in enumerate(entries):
                self.put(5 + index, 2, entry, 3, width - 4)
        elif self.page == 0 and width >= 111 and height >= 28:
            self.wide_overview(height, width)
        elif self.page == 0:
            cpu_height = min(15, height - 14)
            self.cpu_panel(3, width, cpu_height)
            y = 3 + cpu_height
            third = width // 3
            if width >= 82:
                self.memory_panel(y, 0, third)
                self.gpu_panel(y, third, third)
                self.io_panel(y, third * 2, width - third * 2)
            else:
                half = width // 2
                self.memory_panel(y, 0, half)
                self.gpu_panel(y, half, width - half)
            self.process_panel(y + 6, width, height - y - 7)
        else:
            self.detail(height, width)
        footer = "q Quit   ? Keys   / Filter   s Sort   t Tree   ↑↓ Scroll"
        if self.editing or self.filter:
            footer = ("FILTER › " if self.editing else "FILTER / ") + self.filter
        self.put(height - 1, 1, footer, 1)
        status = f"{len(m.procs)} PROC  //  {m.interval:g}s SAMPLE"
        status_x = width - len(status) - 1
        if status_x - len(footer) >= 3:
            self.put(height - 1, status_x, status, 2)
            gap = status_x - len(footer) - 4
            if gap >= 8:
                self.binary_regions.append((height - 1, len(footer) + 3, 1, gap))
        self.animate(time.monotonic(), force=True)

    def animate(self, now, force=False):
        self.animate_binary(now)
        if self.glyph_region:
            frame = int((now - self.binary_epoch) * self.GLYPH_FPS)
            if force or frame != self.glyph_frame:
                self.animate_glyphs(frame)
                self.glyph_frame = frame
        self.win.refresh()

    def animate_glyphs(self, frame):
        x, count = self.glyph_region
        self.put(0, x, "⟦", self.DARK_RED)
        self.put(0, x + count * 2 + 1, "⟧", self.DARK_RED)
        sweep = frame % count
        tones = (self.DARK_RED, self.DARK_BLUE, self.VIOLET, self.DARK_BLUE, 5)
        pulse = (1, self.PROCESS_GREY, self.HISTORY_RED, self.DARK_RED)
        for index in range(count):
            glyph = self.header_glyphs[index % len(self.header_glyphs)]
            distance = (sweep - index) % count
            if distance < len(pulse):
                color = pulse[distance]
                if distance < 2:
                    glyph = self.GLYPH_BANK[(frame + index * 3) % len(self.GLYPH_BANK)]
            else:
                color = tones[index % len(tones)]
            self.put(0, x + 2 + index * 2, glyph, color)

    def make_binary_streams(self, lanes, span, vertical):
        rng = self.binary_random
        streams = []
        for lane in range(lanes):
            for _ in range(max(1, span // 15)):
                length = rng.randint(3, min(10, max(3, span // 2)))
                streams.append(BinaryStream(
                    lane, rng.randrange(span + length), rng.uniform(2.0, 10.0),
                    not vertical and rng.choice((False, True)),
                    "".join(rng.choices("01", k=length)),
                    rng.randrange(length) if rng.random() < .8 else -1,
                ))
        return streams

    def animate_binary(self, now):
        if self.binary:
            elapsed = now - self.binary_epoch
            self.binary_streams = {region: self.binary_streams[region] for region in self.binary_regions
                                   if region in self.binary_streams}
            for region in self.binary_regions:
                y, x, height, width = region
                vertical = height > width
                lanes, span = (width, height) if vertical else (height, width)
                if region not in self.binary_streams:
                    self.binary_streams[region] = self.make_binary_streams(lanes, span, vertical)
                digits = [[" "] * width for _ in range(height)]
                accents = {}
                for stream in self.binary_streams[region]:
                    steps = stream.offset + elapsed * stream.speed
                    cycles, position = divmod(steps, span + len(stream.digits))
                    cycle, head = int(cycles), int(position)
                    fraction = position - head
                    for index, bit in enumerate(stream.digits):
                        pos = head - index
                        if not 0 <= pos < span:
                            continue
                        if stream.reverse:
                            pos = span - pos - 1
                        row, col = (pos, stream.lane) if vertical else (stream.lane, pos)
                        digits[row][col] = bit if cycle % 2 == 0 else ("1" if bit == "0" else "0")
                        if stream.glint >= 0 and index == (stream.glint + cycle) % len(stream.digits):
                            accents[row, col] = self.BINARY_WHITE
                        elif index == len(stream.digits) - 1 and fraction > .3:
                            accents[row, col] = self.BINARY_SHADOW if fraction > .65 else self.BINARY_MID
                        else:
                            accents.pop((row, col), None)
                    if fraction > .3 and head + 1 < span:
                        pos = span - head - 2 if stream.reverse else head + 1
                        row, col = (pos, stream.lane) if vertical else (stream.lane, pos)
                        if digits[row][col] == " ":
                            bit = stream.digits[0]
                            digits[row][col] = bit if cycle % 2 == 0 else ("1" if bit == "0" else "0")
                            accents[row, col] = self.BINARY_MID if fraction > .65 else self.BINARY_SHADOW
                for row in range(height):
                    self.put(y + row, x, "".join(digits[row]), self.BINARY_RED, width)
                for (row, col), color in accents.items():
                    self.put(y + row, x + col, digits[row][col], color, 1)

    def handle(self, key):
        if key == "\x03":
            return False
        if self.editing:
            if key in ("\n", "\r", curses.KEY_ENTER, "\x1b"):
                self.editing = False
            elif key in ("\b", "\x7f", curses.KEY_BACKSPACE):
                self.filter = self.filter[:-1]
            elif isinstance(key, str) and key.isprintable() and len(self.filter) < 80:
                self.filter += key
            self.offset = 0
            return True
        if key in ("q", "Q"):
            return False
        if key == "?":
            self.help = not self.help
        elif key == "\x1b":
            self.help = False
            self.filter = ""
            self.offset = 0
        elif isinstance(key, str) and key in "123456\t":
            self.page = (self.page + 1) % 6 if key == "\t" else int(key) - 1
            self.detail_scroll = 0
            self.help = False
        elif key == "/":
            self.page = 5
            self.help = False
            self.editing = True
        elif key == "s":
            self.sort = (self.sort + 1) % len(self.SORT_FIELDS)
            self.reverse = self.sort < 2
            self.offset = 0
            if self.page not in (0, 5):
                self.page = 5
        elif key == "r":
            self.reverse = not self.reverse
            self.offset = 0
        elif key == "t":
            self.tree = not self.tree
            self.offset = 0
            if self.page not in (0, 5):
                self.page = 5
        elif key == "b":
            self.binary = not self.binary
        elif key in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE):
            step = 1 if key in (curses.KEY_UP, curses.KEY_DOWN) else self.visible_processes
            if key in (curses.KEY_UP, curses.KEY_PPAGE):
                step = -step
            attr = "offset" if self.page in (0, 5) else "detail_scroll"
            setattr(self, attr, max(0, min(self.scroll_limit, getattr(self, attr) + step)))
        return True


def run(window, monitor):
    screen = Screen(window, monitor)
    next_sample = 0.0
    next_animation = 0.0
    dirty = True
    while True:
        now = time.monotonic()
        monitor.poll_gpu(now)
        if now >= next_sample:
            monitor.sample()
            next_sample = now + monitor.interval
            dirty = True
        now = time.monotonic()
        redrawn = dirty
        if dirty:
            screen.draw()
            dirty = False
        animation_hz = Screen.GLYPH_FPS if screen.glyph_region else 0
        if screen.binary and screen.binary_regions:
            animation_hz = 60
        if animation_hz and (redrawn or now >= next_animation):
            if not redrawn:
                screen.animate(now)
            next_animation = (math.floor(now * animation_hz) + 1) / animation_hz
        deadline = min(next_sample, next_animation) if animation_hz else next_sample
        wait_ms = math.ceil((deadline - time.monotonic()) * 1000)
        window.timeout(max(1, min(125, wait_ms)))
        try:
            key = window.get_wch()
        except curses.error:
            continue
        if not screen.handle(key):
            return
        dirty = True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--interval", type=float, default=1.0,
                        help="sample interval in seconds (0.5 to 30, default 1)")
    args = parser.parse_args()
    if not 0.5 <= args.interval <= 30:
        parser.error("--interval must be between 0.5 and 30 seconds")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        parser.error("an interactive terminal is required")
    original_term = os.environ.get("TERM")
    if original_term == "xterm-kitty" and curses.has_extended_color_support():
        # Use Kitty's direct RGB support without rewriting its indexed palette.
        try:
            curses.setupterm("xterm-direct")
        except curses.error:
            pass
        else:
            os.environ["TERM"] = "xterm-direct"
    try:
        with ThreadPoolExecutor(max_workers=1) as executor:
            curses.wrapper(run, Monitor(executor, args.interval))
    except KeyboardInterrupt:
        return
    finally:
        if original_term == "xterm-kitty":
            os.environ["TERM"] = original_term


if __name__ == "__main__":
    main()
