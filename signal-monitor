def size(value):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
        if value < 1024 or unit == "PiB":
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024


def rate(value):
    return f"{size(value)}/s"


def age(seconds):
    days, remainder = divmod(max(0, int(seconds)), 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes = remainder // 60
    return f"{days}d {hours:02}:{minutes:02}" if days else f"{hours:02}:{minutes:02}"


def palette_rgb(index):
    if index >= 232:
        shade = 8 + 10 * (index - 232)
        return shade * 0x010101
    level = (0, 95, 135, 175, 215, 255)
    red, remainder = divmod(index - 16, 36)
    green, blue = divmod(remainder, 6)
    return (level[red] << 16) | (level[green] << 8) | level[blue]


def delta(now, before, field, elapsed):
    if before is None:
        return 0.0
    return max(0, getattr(now, field) - getattr(before, field)) / elapsed


def cpu_name():
    try:
        with open("/proc/cpuinfo") as source:
            for line in source:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return "CPU"


def cpu_ids():
    ids = []
    try:
        with open("/proc/stat") as source:
            for line in source:
                tag = line.split(None, 1)[0]
                if not tag.startswith("cpu"):
                    break
                if tag[3:].isdigit():
                    ids.append(int(tag[3:]))
    except OSError:
        pass
    return ids


def core_topology(ids):
    result = {}
    for cpu in ids:
        path = Path(f"/sys/devices/system/cpu/cpu{cpu}/topology")
        try:
            package = int((path / "physical_package_id").read_text())
            core = int((path / "core_id").read_text())
        except (OSError, ValueError):
            continue
        result[cpu] = (package, core)
    return result


def read_core_temperatures(topology, hwmon=Path("/sys/class/hwmon")):
    by_core = {}
    for device in hwmon.glob("hwmon*"):
        try:
            if (device / "name").read_text().strip() != "coretemp":
                continue
        except OSError:
            continue
        package = None
        readings = {}
        for path in device.glob("temp*_label"):
            try:
                label = path.read_text().strip()
                kind, _, number = label.rpartition(" ")
                if kind == "Package id":
                    package = int(number)
                elif kind == "Core":
                    sensor = path.with_name(path.name.removesuffix("_label") + "_input")
                    readings[int(number)] = int(sensor.read_text()) / 1000
            except (OSError, ValueError):
                continue
        if package is not None:
            by_core.update({(package, core): value for core, value in readings.items()})
    return {cpu: by_core[key] for cpu, key in topology.items() if key in by_core}


def read_gpu(executable):
    if executable is None:
        return [], "nvidia-smi unavailable"
    fields = "name,utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw,fan.speed"
    try:
        result = subprocess.run(
            [executable, "--query-gpu=" + fields, "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=1.5, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return [], "NVIDIA telemetry unavailable"
    rows = [row for row in csv.reader(result.stdout.splitlines(), skipinitialspace=True) if len(row) == 7]
    return rows, None if rows else "No NVIDIA GPU reported"


def usable_number(value):
    try:
        number = float(value)
    except ValueError:
        return 0.0
    return number if math.isfinite(number) else 0.0


def metric(value, unit):
    return "—" if value in ("N/A", "[N/A]", "[Not Supported]") else value + unit


def read_disks():
    try:
        return psutil.disk_io_counters(perdisk=True, nowrap=False) or {}
    except OSError:
        return {}


def read_network():
    try:
        return psutil.net_io_counters(pernic=True, nowrap=False) or {}
    except OSError:
        return {}


def read_mounts():
    mounts = []
    seen = set()
    for part in sorted(psutil.disk_partitions(), key=lambda p: (p.mountpoint.count("/"), p.mountpoint)):
        if not part.device.startswith("/dev/") or part.device.startswith("/dev/sr"):
            continue
        if part.device in seen:
            continue
        try:
            usage = psutil.disk_usage(part.mountpoint)
        except OSError:
            continue
        seen.add(part.device)
        mounts.append((part.mountpoint, usage))
    return mounts


class Process(NamedTuple):
    pid: int
    name: str
    cpu: float
    rss: int
    state: str
    parent: int
    threads: int | None
    user: str


class BinaryStream(NamedTuple):
    lane: int
    offset: int
    speed: float
    reverse: bool
    digits: str
    glint: int


class Monitor:
    def __init__(self, executor, interval):
        self.executor = executor
        self.gpu_command = shutil.which("nvidia-smi")
        self.interval = interval
        self.host = socket.gethostname()
        self.model = cpu_name()
        self.physical = psutil.cpu_count(logical=False)
        self.allowed = len(os.sched_getaffinity(0))
        self.boot = psutil.boot_time()
        self.cpu = 0.0
        self.cores = []
        self.cpu_ids = []
        self.topology = None
        self.core_temps = {}
        self.freq = self.temp = None
        self.mem = self.swap = None
        self.mounts = []
        self.drives = []
        self.links = []
        self.procs = []
        self.users = {}
        self.gpus = []
        self.gpu_message = "Sampling NVIDIA telemetry"
        self.graphs = {name: deque(maxlen=360) for name in ("cpu", "gpu", "read", "write", "rx", "tx")}
        self.core_history = defaultdict(lambda: deque(maxlen=40))
        self.last_disk = read_disks()
        self.last_net = read_network()
        self.last_proc = {}
        self.proc_history = {}
        self.last_sample = time.monotonic()
        self.next_detail = self.next_gpu = 0
        self.pending_gpu = None
        psutil.cpu_percent()
        psutil.cpu_percent(percpu=True)

    def poll_gpu(self, now):
        if self.pending_gpu is not None and self.pending_gpu.done():
            self.gpus, self.gpu_message = self.pending_gpu.result()
            self.pending_gpu = None
            self.graphs["gpu"].append(usable_number(self.gpus[0][1]) if self.gpus else 0)
        if self.pending_gpu is None and now >= self.next_gpu:
            self.pending_gpu = self.executor.submit(read_gpu, self.gpu_command)
            self.next_gpu = now + max(2.0, self.interval)

    def sample(self):
        now = time.monotonic()
        elapsed = max(0.001, now - self.last_sample)
        self.last_sample = now
        self.cpu = psutil.cpu_percent()
        self.cores = psutil.cpu_percent(percpu=True)
        ids = cpu_ids()
        known_ids = len(ids) == len(self.cores)
        if not known_ids:
            self.core_temps = {}
            self.topology = None
            ids = list(range(len(self.cores)))
        if ids != self.cpu_ids or (known_ids and self.topology is None):
            self.cpu_ids = ids
            self.topology = core_topology(ids) if known_ids else None
            self.next_detail = 0
        for cpu, load in zip(self.cpu_ids, self.cores):
            self.core_history[cpu].append(load)
        self.mem = psutil.virtual_memory()
        self.swap = psutil.swap_memory()
        if now >= self.next_detail:
            self.next_detail = now + 3
            try:
                freq = psutil.cpu_freq()
                self.freq = freq.current if freq else None
            except OSError:
                self.freq = None
            try:
                temps = psutil.sensors_temperatures()
            except OSError:
                temps = {}
            candidates = [entry for chip in ("coretemp", "k10temp", "zenpower", "cpu_thermal")
                          for entry in temps.get(chip, ())]
            self.temp = next((entry.current for entry in candidates
                              if entry.label.startswith("Package") or entry.label == "Tdie"), None)
            if self.temp is None:
                self.temp = max((entry.current for entry in candidates), default=None)
            self.core_temps = read_core_temperatures(self.topology) if known_ids else {}
            self.mounts = read_mounts()

        self.graphs["cpu"].append(self.cpu)
        disk = read_disks()
        self.drives = [(name, delta(row, self.last_disk.get(name), "read_bytes", elapsed),
                        delta(row, self.last_disk.get(name), "write_bytes", elapsed))
                       for name, row in sorted(disk.items())
                       if not name.startswith(("loop", "ram", "zram"))
                       and (Path("/sys/block") / name).exists()
                       and not name.startswith(("dm-", "md"))]
        self.last_disk = disk
        network = read_network()
        self.links = [(name, delta(row, self.last_net.get(name), "bytes_recv", elapsed),
                       delta(row, self.last_net.get(name), "bytes_sent", elapsed))
                      for name, row in sorted(network.items()) if name != "lo"]
        self.last_net = network
        for rows, names in ((self.drives, ("read", "write")), (self.links, ("rx", "tx"))):
            for field, name in enumerate(names, 1):
                self.graphs[name].append(sum(row[field] for row in rows))
        self.sample_processes(elapsed)
        self.poll_gpu(now)
        self.load = os.getloadavg()

    def sample_processes(self, elapsed):
        snapshot = {}
        histories = {}
        rows = []
        # Rebuild identities so a reused PID cannot inherit its predecessor's CPU sample.
        psutil.process_iter.cache_clear()
        fields = ("name", "create_time", "cpu_times", "memory_info", "status", "ppid", "num_threads", "uids")
        for proc in psutil.process_iter(fields):
            info = proc.info
            ticks = info["cpu_times"]
            identity = (proc.pid, info["create_time"])
            percent = 0.0
            if ticks is not None:
                total = ticks.user + ticks.system
                previous = self.last_proc.get(identity, total)
                percent = max(0.0, (total - previous) / elapsed * 100)
                snapshot[identity] = total
            history = self.proc_history.get(identity)
            if history is None:
                history = deque(maxlen=28)
            history.append(percent)
            histories[identity] = history
            memory = info["memory_info"]
            uids = info["uids"]
            user = "?"
            if uids is not None:
                uid = uids.real
                if uid not in self.users:
                    try:
                        self.users[uid] = pwd.getpwuid(uid).pw_name
                    except KeyError:
                        self.users[uid] = str(uid)
                user = self.users[uid]
            rows.append(Process(proc.pid, info["name"] or "?", percent,
                                memory.rss if memory else 0, info["status"] or "?",
                                info["ppid"] or 0, info["num_threads"], user))
        self.procs = rows
        self.last_proc = snapshot
        self.proc_history = histories
        self.proc_traces = {pid: history for (pid, _), history in histories.items()}


class Screen:
    KEYS = ("Overview", "CPU", "GPU", "Disks", "Network", "Processes")
    SORT_FIELDS = (2, 3, 1, 0)
    SORT_LABELS = ("CPU", "RAM", "NAME", "PID")
    BLOCKS = " ▁▂▃▄▅▆▇█"
    DOTS = ((0, 64, 68, 70, 71), (0, 128, 160, 176, 184))
    TOP_DOTS = ((0, 1, 3, 7, 71), (0, 8, 24, 56, 184))
    RED, BLUE, DARK_BLUE, DARK_RED, VIOLET, BINARY_RED, BINARY_WHITE = range(10, 17)
    PROCESS_GREY, PROCESS_DIM = range(17, 19)
    ORANGE, NEON_GREEN, AMBER_HALO, AQUA_HALO = range(19, 23)
    HISTORY_RED = 23
    BINARY_SHADOW, BINARY_MID = range(24, 26)
    GLYPH_BANK = "⌁⌬◈⋮⟡⊹∴⟐⊕⌖△⋄⋰⊗⊞⊙⋔▽○■◌◇⊿⋇⌇⌗∺∵"
    GLYPH_FPS = 12

    def __init__(self, window, monitor):
        self.win = window
        self.monitor = monitor
        self.page = 0
        self.sort = 0
        self.reverse = True
        self.tree = True
        self.offset = 0
        self.detail_scroll = 0
        self.filter = ""
        self.editing = False
        self.help = False
        self.binary = True
        self.binary_regions = []
        self.binary_streams = {}
        self.binary_random = Random()
        self.binary_epoch = time.monotonic()
        self.header_glyphs = self.binary_random.choices(self.GLYPH_BANK, k=128)
        self.glyph_region = None
        self.glyph_frame = -1
        self.scroll_limit = 0
        self.visible_processes = 1
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        self.colors = [curses.A_BOLD, curses.A_BOLD, curses.A_DIM, curses.A_NORMAL,
                       curses.A_BOLD, curses.A_BOLD, curses.A_NORMAL, curses.A_NORMAL,
                       curses.A_BOLD, curses.A_DIM, curses.A_BOLD, curses.A_BOLD,
                       curses.A_NORMAL, curses.A_NORMAL, curses.A_BOLD, curses.A_DIM, curses.A_DIM,
                       curses.A_NORMAL, curses.A_NORMAL, curses.A_BOLD, curses.A_BOLD,
                       curses.A_DIM, curses.A_DIM, curses.A_BOLD, curses.A_DIM, curses.A_DIM]
        if curses.has_colors():
            curses.start_color()
            background = curses.COLOR_BLACK
            try:
                curses.use_default_colors()
                background = -1
            except curses.error:
                pass
            indexed = (118, 51, 29, 194, 57, 220, 40, 35, 226, 22,
                       196, 39, 25, 124, 57, 52, 250, 252, 245, 208, 82, 94, 23, 124,
                       233, 52)
            if curses.COLORS >= 1 << 24:
                colors = [palette_rgb(index) for index in indexed]
                colors[4] = colors[self.VIOLET] = 0x5600FC
                colors[self.PROCESS_GREY] = 0xD3D3D3
                colors[self.HISTORY_RED] = 0xB52030
                colors[self.BINARY_SHADOW] = 0x380000
                colors[self.BINARY_MID] = 0x4D0000
            elif curses.COLORS >= 256:
                colors = indexed
            else:
                colors = (
                    curses.COLOR_GREEN, curses.COLOR_CYAN, curses.COLOR_GREEN,
                    curses.COLOR_WHITE, curses.COLOR_MAGENTA, curses.COLOR_YELLOW, curses.COLOR_GREEN,
                    curses.COLOR_CYAN, curses.COLOR_YELLOW, curses.COLOR_GREEN,
                    curses.COLOR_RED, curses.COLOR_BLUE, curses.COLOR_BLUE, curses.COLOR_RED,
                    curses.COLOR_MAGENTA, curses.COLOR_RED, curses.COLOR_WHITE,
                    curses.COLOR_WHITE, curses.COLOR_WHITE, curses.COLOR_YELLOW, curses.COLOR_GREEN,
                    curses.COLOR_YELLOW, curses.COLOR_CYAN, curses.COLOR_RED,
                    curses.COLOR_RED, curses.COLOR_RED,
                )
            for pair, color in enumerate(colors, 1):
                if pair < curses.COLOR_PAIRS:
                    curses.init_pair(pair, color, background)
                    self.colors[pair - 1] |= curses.color_pair(pair)

    def put(self, y, x, value, color=3, width=None):
        h, w = self.win.getmaxyx()
        available = w - x - 1
        if y < 0 or y >= h or x < 0 or available <= 0:
            return
        if width is not None:
            available = min(available, width)
        if available <= 0:
            return
        value = "".join(ch if ch.isprintable() else "?" for ch in str(value))
        if value.isascii():
            value = value[:available]
        else:
            cells = 0
            for index, ch in enumerate(value):
                if not combining(ch):
                    cells += 2 if east_asian_width(ch) in ("W", "F") else 1
                if cells > available:
                    value = value[:index]
                    break
        try:
            self.win.addstr(y, x, value, self.colors[color])
        except curses.error:
            pass

    def box(self, y, x, height, width, title, color=0, trim=None, rail_color=2):
        self.put(y, x, "┌──╼ ", color if trim else 6, width - 1)
        self.put(y, x + 5, title, color, width - 6)
        start = min(len(title) + 6, width - 1)
        rail = width - start - 1
        pattern = trim or "-·-"
        self.put(y, x + start, (pattern * width)[:rail] + "┐", rail_color, width - start)
        if trim and rail >= 8:
            self.put(y, x + width - 6, "||||", color, 4)
        for row in range(y + 1, y + height - 1):
            edge = "┆" if (row - y) % 4 == 0 else "│"
            self.put(row, x, edge, rail_color)
            self.put(row, x + width - 1, edge, color if trim and edge == "┆" else rail_color)
        self.put(y + height - 1, x, "└──" + "." * (width - 6) + "──┘", rail_color, width)
        if trim:
            self.put(y + height - 1, x + 3, "----", color, 4)
            self.put(y + height - 1, x + width - 7, "----", color, 4)

    def bar(self, y, x, width, percent, color=0):
        filled = round(width * min(100, max(0, percent)) / 100)
        self.put(y, x, "·" * width, self.DARK_BLUE if color in (1, self.BLUE, self.VIOLET) else 9, width)
        if filled:
            edge = max(1, filled // 5)
            shadow = {0: 6, 1: self.DARK_BLUE, self.BLUE: self.DARK_BLUE, self.RED: self.DARK_RED}
            self.put(y, x, "▓" * (filled - edge), shadow.get(color, color), width)
            self.put(y, x + filled - edge, "█" * edge, color, edge)
            if filled < width:
                self.put(y, x + filled, "░", 2)

    def graph(self, y, x, height, width, key, upper, color):
        values = self.monitor.graphs[key]
        bars = list(values)[-width:]
        for line in range(height):
            threshold = (height - line - 1) * 8
            plot = "".join(self.BLOCKS[min(8, max(0, math.ceil(v / upper * height * 8) - threshold))]
                           for v in bars)
            self.put(y + line, x, plot.rjust(width), color, width)

    def trace(self, y, x, height, width, key, upper, colors, mirrored=False, grid=(), grid_color=2):
        samples = list(self.monitor.graphs[key])[-2 * width:]
        levels = [0] * (2 * width - len(samples))
        levels.extend(min(height * 4, math.ceil(value * height * 4 / upper)) for value in samples)
        dots = self.TOP_DOTS if mirrored else self.DOTS
        for row in range(height):
            depth = row if mirrored else height - 1 - row
            threshold = depth * 4
            glyphs = []
            for left, right in zip(levels[::2], levels[1::2]):
                first = dots[0][min(4, max(0, left - threshold))]
                second = dots[1][min(4, max(0, right - threshold))]
                glyphs.append(chr(0x2800 + (first | second)) if first or second else " ")
            color = colors[min(len(colors) - 1, depth * len(colors) // height)]
            self.put(y + row, x, "".join(glyphs), color, width)
            if row in grid:
                for col in range(0, width, 3):
                    if glyphs[col] == " ":
                        self.put(y + row, x + col, ".", grid_color)

    def wide_overview(self, height, width):
        top = 3
        bottom_height = min(15, max(10, height // 3))
        upper_height = height - top - bottom_height - 2
        left = width * 54 // 100
        right_x = left + 1
        self.binary_regions.append((top, left, upper_height, 1))
        self.binary_regions.append((top + upper_height, 1, 1, width - 2))
        right = width - right_x
        memory_width = right // 2
        stats_height = min(11, max(7, upper_height // 2))
        self.process_panel(top, left, upper_height)
        self.wide_memory(top, right_x, memory_width, stats_height)
        self.wide_storage(top, right_x + memory_width, right - memory_width, stats_height)
        self.wide_network(top + stats_height, right_x, right, upper_height - stats_height)
        self.wide_compute(top + upper_height + 1, width, bottom_height)

    def wide_memory(self, y, x, width, height):
        m = self.monitor
        self.box(y, x, height, width, f"MEMORY / {size(m.mem.total)}", self.VIOLET, "....")
        used = m.mem.total - m.mem.available
        data = (("Used", used, m.mem.total, self.RED if m.mem.percent >= 85 else 0),
                ("Available", m.mem.available, m.mem.total, 1),
                ("Cache", getattr(m.mem, "cached", 0), m.mem.total, self.BLUE),
                ("Swap", m.swap.used, m.swap.total, self.VIOLET))
        large = height >= 10
        for i, (label, amount, total, color) in enumerate(data):
            row = y + 1 + i * (2 if large else 1)
            value = f"{label:.<10}{size(amount) if total else 'off'}"
            if i == 3 and total:
                full = f"{value} / {size(total)}"
                if len(full) <= width - 4:
                    value = full
            remaining = width - 5 - len(value)
            self.put(row, x + 2, value, color, width - 4)
            if total:
                if large:
                    self.bar(row + 1, x + 2, width - 4, amount / total * 100, color)
                elif remaining >= 4:
                    self.bar(row, x + 3 + len(value), remaining, amount / total * 100, color)

    def wide_storage(self, y, x, width, height):
        m = self.monitor
        self.box(y, x, height, width, "STORAGE", 5, "----.")
        for i, (mount, usage) in enumerate(m.mounts[:height - 4]):
            name = "root" if mount == "/" else Path(mount).name
            suffix = f" {usage.percent:3.0f}% {size(usage.total)}"
            meter = min(10, max(0, width - 31))
            room = max(2, width - 4 - len(suffix) - meter)
            self.put(y + i + 1, x + 2, f"{name:.<{room}.{room}}", 3, room)
            if meter > 0:
                self.bar(y + i + 1, x + 2 + room, meter, usage.percent, self.RED if usage.percent >= 90 else 0)
            self.put(y + i + 1, x + 2 + room + meter, suffix, self.RED if usage.percent >= 90 else 3, len(suffix))
        for index, (label, key) in enumerate((("Read", "read"), ("Write", "write"))):
            value = rate(m.graphs[key][-1]) if m.drives else "—"
            self.put(y + height - 3 + index, x + 2, f"{label:.<9}{value}", 1 if index == 0 else 5, width - 4)

    def wide_network(self, y, x, width, height):
        m = self.monitor
        self.box(y, x, height, width, "NETWORK // AGGREGATE", self.BLUE, "~~~~")
        if not m.links:
            self.put(y + 1, x + 2, "No non-loopback interfaces visible", 2, width - 4)
            if height >= 5:
                self.put(y + 2, x + 2, ("~~~~...." * width)[:width - 4], self.DARK_BLUE, width - 4)
            return
        tx, rx = m.graphs["tx"], m.graphs["rx"]
        self.put(y + 1, x + 2, f"TX ↑ {rate(tx[-1])}", 0, width // 2 - 2)
        self.put(y + 1, x + width // 2, f"RX ↓ {rate(rx[-1])}", 1, width // 2 - 2)
        if height < 6:
            return
        top = (height - 4) // 2
        bottom = height - 4 - top
        self.trace(y + 2, x + 2, top, width - 4, "tx", max(1, max(tx)), (0, 5, self.RED), grid=(0,))
        separator = y + 2 + top
        self.put(separator, x + 2, ("~~~~----" * width)[:width - 4], self.DARK_BLUE, width - 4)
        self.put(separator, x + width - 8, " 0 B/s", 1, 6)
        self.trace(y + 3 + top, x + 2, bottom - 1, width - 4, "rx", max(1, max(rx)),
                   (self.BLUE, 1, self.VIOLET), True, grid=(bottom - 2,))

    def wide_compute(self, y, width, height):
        m = self.monitor
        graph_width = width * 38 // 100
        self.box(y, 0, height, graph_width, "CPU HISTORY // %", 0)
        stats = f"{m.cpu:.1f}%"
        if m.freq:
            stats += f"   {m.freq / 1000:.2f} GHz"
        if m.temp is not None:
            stats += f"   {m.temp:.0f}°C"
        self.put(y + 1, 2, stats, 0, graph_width - 4)
        plot_height = height - 4
        marks = {round((100 - level) / 100 * (plot_height - 1)): level for level in (100, 75, 50, 25, 0)}
        self.trace(y + 2, 7, plot_height, graph_width - 9, "cpu", 100, (0, 6, 1, 8),
                   grid=marks, grid_color=self.PROCESS_GREY)
        for row, level in marks.items():
            self.put(y + 2 + row, 2, f"{level:>3}┤", self.HISTORY_RED)
            self.put(y + 2 + row, 6, "▏", self.BINARY_RED)
        self.put(y + height - 2, 1, "░", self.BINARY_RED)
        load = "LOAD  " + "   ".join(f"{n:.2f}" for n in m.load)
        self.put(y + height - 2, 2, load, self.HISTORY_RED, graph_width - 4)
        if len(load) + 4 < graph_width:
            self.put(y + height - 2, len(load) + 2, "░", self.BINARY_RED)
        x = graph_width + 1
        panel_width = width - x
        self.box(y, x, height, panel_width, f"COMPUTE // {len(m.cores)} LOGICAL CPUs", 0, "----")
        thermal = bool(m.core_temps)
        columns = min(8, (panel_width - 4) // (16 if thermal else 13))
        cell = (panel_width - 4) // columns
        grid_rows = height - 4
        for index, load in enumerate(m.cores[:columns * grid_rows]):
            line = y + 1 + index // columns
            col = x + 2 + index % columns * cell
            cpu = m.cpu_ids[index]
            plot_width = cell - (15 if thermal else 11)
            levels = list(m.core_history[cpu])[-plot_width:]
            plot = "".join(self.BLOCKS[min(8, math.ceil(value * 8 / 100))] for value in levels)
            color = self.RED if load >= 80 else 5 if load >= 60 else 0
            self.put(line, col, f"{cpu:02}", self.BLUE, 2)
            self.put(line, col + 3, f"{load:3.0f}%", color, 4)
            self.put(line, col + 8, plot.rjust(plot_width, "·"), color, plot_width)
            if thermal:
                self.core_temperature(line, col + cell - 6, cpu)
            if index % columns < columns - 1:
                self.put(line, col + cell - 1, "|", self.DARK_BLUE)
        used_rows = math.ceil(len(m.cores) / columns)
        if used_rows < grid_rows:
            self.put(y + 1 + used_rows, x + 2, m.model, self.BLUE, panel_width - 4)
            spare = grid_rows - used_rows - 1
            if spare > 0:
                self.binary_regions.append((y + 2 + used_rows, x + 2, spare, panel_width - 4))
        self.put(y + height - 3, x + 2, ("----||||" * panel_width)[:panel_width - 4], self.VIOLET)
        if m.gpus:
            _, load, temp, used, total, power, _ = m.gpus[0]
            brief = f"GPU  {metric(load, '%')}   {metric(temp, '°C')}   {metric(power, ' W')}"
            if usable_number(total) > 0 and metric(used, "") != "—":
                brief += f"   VRAM {size(usable_number(used) * 1048576)} / {size(usable_number(total) * 1048576)}"
            color = self.RED if usable_number(temp) >= 85 else self.VIOLET
            self.put(y + height - 2, x + 2, brief, color, panel_width - 4)
            meter_width = panel_width - 6 - len(brief)
            if meter_width >= 5:
                self.bar(y + height - 2, x + 4 + len(brief), meter_width, usable_number(load), color)
        else:
            self.put(y + height - 2, x + 2, m.gpu_message, 4, panel_width - 4)

    def core_temperature(self, row, x, cpu):
        temp = self.monitor.core_temps.get(cpu)
        if temp is None:
            self.put(row, x, "    —", 2, 5)
            return
        color = self.RED if temp >= 85 else 5 if temp >= 70 else 1
        self.put(row, x, f"{temp:3.0f}°C", color, 5)

    def cpu_panel(self, y, width, height):
        m = self.monitor
        stats = f"{m.cpu:5.1f}%  LOAD  " + "  ".join(f"{n:.2f}" for n in m.load)
        if m.freq:
            stats += f"     {m.freq / 1000:.2f} GHz"
        if m.temp is not None:
            stats += f"     {m.temp:.0f}°C"
        self.box(y, 0, height, width, "CPU")
        self.put(y + 1, 2, stats, 0, width - 4)
        thermal = bool(m.core_temps)
        columns = min(len(m.cores) or 1, max(1, (width - 4) // (17 if thermal else 14)), 8)
        per_row = (width - 4) // columns
        total_rows = math.ceil(len(m.cores) / columns)
        graph_height = max(1, min(8, height - 4 - total_rows))
        rows = height - 4 - graph_height
        self.graph(y + 2, 2, graph_height, width - 4, "cpu", 100, 0)
        self.put(y + 2 + graph_height, 2, "─" * (width - 4), 2)
        first = 0
        if self.page == 1:
            self.scroll_limit = max(0, total_rows - rows)
            self.detail_scroll = min(self.detail_scroll, self.scroll_limit)
            self.visible_processes = rows
            first = self.detail_scroll * columns
        elif total_rows > rows:
            rows -= 1
            self.put(y + height - 2, 2, "2  View all logical CPUs", 1, width - 4)
        for index, percent in enumerate(m.cores[first:first + rows * columns]):
            row = y + 3 + graph_height + index // columns
            x = 2 + index % columns * per_row
            cpu = m.cpu_ids[first + index]
            self.put(row, x, f"{cpu:02} {percent:3.0f}%", 3, 8)
            meter = per_row - (16 if thermal else 10)
            self.bar(row, x + 8, meter, percent, self.RED if percent >= 80 else 0)
            if thermal:
                self.core_temperature(row, x + per_row - 6, cpu)

    def memory_panel(self, y, x, width):
        m = self.monitor
        self.box(y, x, 6, width, "MEMORY", self.VIOLET, "....")
        self.put(y + 1, x + 2, f"RAM   {size(m.mem.total - m.mem.available)} / {size(m.mem.total)}", 3, width - 4)
        self.bar(y + 2, x + 2, width - 4, m.mem.percent, 1)
        text = f"{size(m.swap.used)} / {size(m.swap.total)}" if m.swap.total else "disabled"
        self.put(y + 3, x + 2, f"SWAP  {text}", 3, width - 4)
        self.bar(y + 4, x + 2, width - 4, m.swap.percent, 1)

    def gpu_panel(self, y, x, width):
        m = self.monitor
        self.box(y, x, 6, width, "GPU", self.VIOLET, "----")
        if not m.gpus:
            self.put(y + 2, x + 2, m.gpu_message, 2, width - 4)
